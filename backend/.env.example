# Optional. Copy to backend/.env. Never commit the real file.

# Market data: auto (Angel One once credentials are saved in Settings, else simulated) | simulated
QV_MARKET_DATA=auto

# Where QuantVision keeps its database, paper-trading state and profile picture.
# QV_HOME=C:\Users\you\Documents\QuantVision

# Angel One SmartAPI credentials are entered on the /setup page and stored
# encrypted with your QuantVision password. The values below are only read as a
# one-time import ("Import from backend/.env"); delete them afterwards.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# Base32 secret shown when enabling TOTP for SmartAPI (not the 6-digit code)
ANGEL_TOTP_SECRET=
