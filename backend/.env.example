# Copy to backend/.env. Never commit the real file.
# Phase 2 moves these credentials into the encrypted local store via the /setup page.

# Market data source: auto (Angel One if credentials below are set, else simulated) | angelone | simulated
QV_MARKET_DATA=auto

# Where QuantVision keeps its SQLite database, scripts and logs.
# QV_HOME=C:\Users\you\Documents\QuantVision

# Angel One SmartAPI (https://smartapi.angelbroking.com/)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# Your Angel One login MPIN
ANGEL_PIN=
# Base32 secret shown when enabling TOTP for SmartAPI (not the 6-digit code)
ANGEL_TOTP_SECRET=
